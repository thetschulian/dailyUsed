# ============================================================================
# BULLETPROOF LogRemover Bootstrap Script
# Copy & Paste this entire script into PowerShell (run as Administrator)
# It will create and install LogRemover automatically
# ============================================================================

# Check if running as Administrator
$IsAdmin = ([Security.Principal.WindowsPrincipal] [Security.Principal.WindowsIdentity]::GetCurrent()).IsInRole([Security.Principal.WindowsBuiltInRole]::Administrator)
if (-not $IsAdmin) {
    Write-Output ""
    Write-Output "❌ ERROR: Administrator privileges required!"
    Write-Output ""
    Write-Output "Please close this window and:"
    Write-Output "  1. Right-click PowerShell or ISE"
    Write-Output "  2. Select 'Run as administrator'"
    Write-Output "  3. Copy & paste this entire script again"
    Write-Output ""
    Read-Host "Press Enter to exit"
    exit 1
}

# ============================================================================
# CONFIGURATION VARIABLES - Edit these, then re-run to apply changes
# ============================================================================
$TargetDir     = "C:\Program Files (x86)\LogRemover"
$ScriptFile    = Join-Path $TargetDir "LogRemover.ps1"
$LogDir        = Join-Path $TargetDir "Logs"
$LogFile       = Join-Path $LogDir "LogRemover.log"
$MaxLogSize    = 50MB
$MaxLogFiles   = 3
$LogDirectories = @(
    "C:\inetpub\logs\LogFiles\W3SVC1"
    "C:\inetpub\wwwroot\Citrix\StorageCenter\SC\logs"
    "C:\temp"
)
$DaysOld       = 5
$TaskName      = "LogRemover-CleanOldFiles"
$ScheduleTime  = "02:00"
$DryRun        = $false   # <-- Set to $true to LOG what WOULD be deleted, without deleting anything

Write-Output ""
Write-Output "=========================================="
Write-Output "  LogRemover - Bulletproof Bootstrap"
Write-Output "=========================================="
Write-Output ""

# Verify at least one target directory exists
$ValidDirs = @($LogDirectories | Where-Object { Test-Path -Path $_ })
if ($ValidDirs.Count -eq 0) {
    Write-Output "ERROR: None of the target directories exist:"
    $LogDirectories | ForEach-Object { Write-Output "  - $_" }
    Read-Host "Press Enter to exit"
    exit 1
}

Write-Output "✓ Target directories to process:"
foreach ($d in $LogDirectories) {
    $status = if (Test-Path -Path $d) { "OK" } else { "MISSING (will be skipped)" }
    Write-Output "  - $d [$status]"
}

# Create log directory if it doesn't exist
if (-not (Test-Path -Path $LogDir)) {
    New-Item -ItemType Directory -Path $LogDir -Force | Out-Null
}

# Logging function with rotation
function Write-LogEntry {
    param(
        [string]$Message,
        [string]$Level = "INFO"
    )
    
    $Timestamp = Get-Date -Format "yyyy-MM-dd HH:mm:ss"
    $LogMessage = "[$Timestamp] [$Level] $Message"
    
    # Write to console
    Write-Output $LogMessage
    
    # Check if log file needs rotation
    if ((Test-Path -Path $LogFile) -and (Get-Item $LogFile).Length -gt $MaxLogSize) {
        Rotate-LogFile
    }
    
    # Write to log file
    Add-Content -Path $LogFile -Value $LogMessage -ErrorAction SilentlyContinue
}

# Log rotation function
function Rotate-LogFile {
    $LogBaseName = [System.IO.Path]::GetFileNameWithoutExtension($LogFile)
    $LogExtension = [System.IO.Path]::GetExtension($LogFile)
    
    try {
        # Rename existing logs
        for ($i = $MaxLogFiles - 1; $i -gt 0; $i--) {
            $OldLog = Join-Path $LogDir "$($LogBaseName).$i$LogExtension"
            $NewLog = Join-Path $LogDir "$($LogBaseName).$($i + 1)$LogExtension"
            
            if (Test-Path -Path $OldLog) {
                if ($i + 1 -gt $MaxLogFiles) {
                    Remove-Item -Path $OldLog -Force -ErrorAction SilentlyContinue
                } else {
                    Rename-Item -Path $OldLog -NewName (Split-Path $NewLog -Leaf) -Force -ErrorAction SilentlyContinue
                }
            }
        }
        
        # Rename current log to .1
        if (Test-Path -Path $LogFile) {
            $NewLogName = "$($LogBaseName).1$LogExtension"
            Rename-Item -Path $LogFile -NewName $NewLogName -Force -ErrorAction SilentlyContinue
        }
        
        # Clean up logs older than max
        Get-ChildItem -Path $LogDir -Filter "$($LogBaseName).*$LogExtension" -ErrorAction SilentlyContinue | 
            Where-Object { [int]($_.BaseName -replace "$LogBaseName.", "") -gt $MaxLogFiles } |
            Remove-Item -Force -ErrorAction SilentlyContinue
    }
    catch {
        Write-Output "Warning: Could not rotate log file: $_"
    }
}

Write-LogEntry "=========================================="
Write-LogEntry "  LogRemover - Bulletproof Bootstrap"
Write-LogEntry "=========================================="
Write-LogEntry ""

# Create target directory
if (-not (Test-Path -Path $TargetDir)) {
    New-Item -ItemType Directory -Path $TargetDir -Force | Out-Null
    Write-LogEntry "✓ Created directory: $TargetDir"
}

# ============================================================================
# SAFETY: Reject dangerous directories BEFORE deploying the script
# ============================================================================
$ForbiddenPaths = @(
    "C:\", "C:\Windows", "C:\Windows\System32", "C:\Windows\SysWOW64",
    "C:\Program Files", "C:\Program Files (x86)", "C:\Users", "C:\ProgramData",
    "C:\Windows\System", "C:\Windows\Boot", "C:\Windows\Fonts"
)

foreach ($dir in $LogDirectories) {
    $normalized = $dir.TrimEnd('\')
    # Block exact matches to protected system paths
    if ($ForbiddenPaths -contains $normalized) {
        Write-Output "❌ CRITICAL: Refusing to install - dangerous directory in list: $dir"
        Write-Output "This path is a protected system location and will NOT be processed."
        Read-Host "Press Enter to exit"
        exit 1
    }
    # Block anything with fewer than 2 path segments (e.g. C:\ or D:\)
    if (($normalized -split '\\').Count -lt 2 -or $normalized -match '^[A-Za-z]:$') {
        Write-Output "❌ CRITICAL: Refusing to install - path too shallow / drive root: $dir"
        Read-Host "Press Enter to exit"
        exit 1
    }
}
Write-LogEntry "✓ All configured directories passed the safety denylist"

# Define the BULLETPROOF LogRemover script
$LogRemoverScript = @'
# ============================================================================
# BULLETPROOF LogRemover Script
# CRITICAL: This script has multiple safety checks to prevent deletion of wrong files
# ============================================================================

# Injected by bootstrap at install time
$TargetLogDirs = __TARGET_LOG_DIRS__
$LogDir = "__LOG_DIR__"
$LogFile = "$LogDir\LogRemover.log"
$DaysOld = __DAYS_OLD__
$MaxLogSize = __MAX_LOG_SIZE__
$MaxLogFiles = __MAX_LOG_FILES__
$DryRun = __DRY_RUN__

# Protected system paths that must NEVER be processed
$ForbiddenPaths = @(
    "C:\", "C:\Windows", "C:\Windows\System32", "C:\Windows\SysWOW64",
    "C:\Program Files", "C:\Program Files (x86)", "C:\Users", "C:\ProgramData",
    "C:\Windows\System", "C:\Windows\Boot", "C:\Windows\Fonts"
)

# VERIFY ADMIN RIGHTS
$IsAdmin = ([Security.Principal.WindowsPrincipal] [Security.Principal.WindowsIdentity]::GetCurrent()).IsInRole([Security.Principal.WindowsBuiltInRole]::Administrator)
if (-not $IsAdmin) {
    Write-Output "ERROR: Not running as Administrator - Aborting"
    exit 1
}

# Create log directory
if (-not (Test-Path -Path $LogDir)) {
    New-Item -ItemType Directory -Path $LogDir -Force -ErrorAction SilentlyContinue | Out-Null
}

# Logging function with rotation
function Write-LogEntry {
    param([string]$Message, [string]$Level = "INFO")
    $Timestamp = Get-Date -Format "yyyy-MM-dd HH:mm:ss"
    $LogMessage = "[$Timestamp] [$Level] $Message"
    Write-Output $LogMessage
    
    if ((Test-Path -Path $LogFile) -and (Get-Item $LogFile).Length -gt $MaxLogSize) {
        Rotate-LogFile
    }
    
    Add-Content -Path $LogFile -Value $LogMessage -ErrorAction SilentlyContinue
}

function Rotate-LogFile {
    $LogBaseName = [System.IO.Path]::GetFileNameWithoutExtension($LogFile)
    $LogExtension = [System.IO.Path]::GetExtension($LogFile)
    
    try {
        for ($i = $MaxLogFiles - 1; $i -gt 0; $i--) {
            $OldLog = "$LogDir\$($LogBaseName).$i$LogExtension"
            $NewLog = "$LogDir\$($LogBaseName).$($i + 1)$LogExtension"
            
            if (Test-Path -Path $OldLog) {
                if ($i + 1 -gt $MaxLogFiles) {
                    Remove-Item -Path $OldLog -Force -ErrorAction SilentlyContinue
                } else {
                    Rename-Item -Path $OldLog -NewName (Split-Path $NewLog -Leaf) -Force -ErrorAction SilentlyContinue
                }
            }
        }
        
        if (Test-Path -Path $LogFile) {
            $NewLogName = "$($LogBaseName).1$LogExtension"
            Rename-Item -Path $LogFile -NewName $NewLogName -Force -ErrorAction SilentlyContinue
        }
        
        Get-ChildItem -Path $LogDir -Filter "$($LogBaseName).*$LogExtension" -ErrorAction SilentlyContinue | 
            Where-Object { [int]($_.BaseName -replace "$LogBaseName.", "") -gt $MaxLogFiles } |
            Remove-Item -Force -ErrorAction SilentlyContinue
    }
    catch {
        Write-Output "Warning: Could not rotate log file: $_"
    }
}

# ============================================================================
# PROCESS EACH DIRECTORY IN THE LIST
# ============================================================================
$CutoffDate = (Get-Date).AddDays(-$DaysOld)
$GrandRemoved = 0
$GrandNotRemoved = 0
$GrandFound = 0

if ($DryRun) {
    Write-LogEntry "*** DRY RUN MODE - No files will be deleted ***" "DRYRUN"
}
Write-LogEntry "Starting cleanup for files older than $DaysOld days across $($TargetLogDirs.Count) directories"

foreach ($TargetLogDir in $TargetLogDirs) {
    $TargetLogDir = $TargetLogDir.TrimEnd('\')
    Write-LogEntry ""
    Write-LogEntry "------ Processing: $TargetLogDir ------"

    # SAFETY CHECK 1: Directory must exist
    if (-not (Test-Path -Path $TargetLogDir)) {
        Write-LogEntry "SKIPPED: Directory does not exist: $TargetLogDir" "WARNING"
        continue
    }

    # SAFETY CHECK 2: Reject protected system paths
    if ($ForbiddenPaths -contains $TargetLogDir) {
        Write-LogEntry "CRITICAL: Refusing to process protected system path: $TargetLogDir" "CRITICAL"
        continue
    }

    # SAFETY CHECK 3: Reject drive roots / too-shallow paths
    if (($TargetLogDir -split '\\').Count -lt 2 -or $TargetLogDir -match '^[A-Za-z]:$') {
        Write-LogEntry "CRITICAL: Refusing to process drive root / shallow path: $TargetLogDir" "CRITICAL"
        continue
    }

    $FilesFound = 0
    $FilesRemoved = 0
    $FilesNotRemoved = 0

    try {
        # Build list of files to delete
        $FilesToDelete = @()
        Get-ChildItem -Path $TargetLogDir -File -ErrorAction Stop | Where-Object { 
            $_.LastWriteTime -lt $CutoffDate 
        } | ForEach-Object {
            $FilesToDelete += $_
            $FilesFound++
        }

        Write-LogEntry "Found $FilesFound files older than $DaysOld days"

        # SAFETY CHECK 4: Verify every file's parent is exactly this directory
        foreach ($File in $FilesToDelete) {
            $FileDir = (Split-Path -Path $File.FullName -Parent).TrimEnd('\')
            if ($FileDir -ne $TargetLogDir) {
                Write-LogEntry "CRITICAL: File outside target dir, skipping whole directory: $($File.FullName)" "CRITICAL"
                $FilesToDelete = @()
                break
            }
        }

        if ($FilesToDelete.Count -eq 0) {
            Write-LogEntry "Nothing to delete in this directory"
        }
        elseif ($DryRun) {
            Write-LogEntry "DRY RUN: $($FilesToDelete.Count) files WOULD be deleted:" "DRYRUN"
            foreach ($File in $FilesToDelete) {
                Write-LogEntry "  [WOULD DELETE] $($File.FullName) (Modified: $($File.LastWriteTime))" "DRYRUN"
            }
        }
        else {
            foreach ($File in $FilesToDelete) {
                try {
                    # FINAL per-file check right before deletion
                    $ParentDir = (Split-Path -Path $File.FullName -Parent).TrimEnd('\')
                    if ($ParentDir -eq $TargetLogDir) {
                        Remove-Item -Path $File.FullName -Force
                        Write-LogEntry "Removed: $($File.FullName) (Modified: $($File.LastWriteTime))"
                        $FilesRemoved++
                    } else {
                        Write-LogEntry "SKIPPED: File not in target directory: $($File.FullName)" "WARNING"
                        $FilesNotRemoved++
                    }
                }
                catch {
                    Write-LogEntry "Failed to remove: $($File.FullName) - Error: $_" "WARNING"
                    $FilesNotRemoved++
                }
            }
        }

        Write-LogEntry "Directory summary: Found $FilesFound, Removed $FilesRemoved, Failed $FilesNotRemoved"
        $GrandFound += $FilesFound
        $GrandRemoved += $FilesRemoved
        $GrandNotRemoved += $FilesNotRemoved
    }
    catch {
        Write-LogEntry "ERROR processing $TargetLogDir : $_" "ERROR"
    }
}

Write-LogEntry ""
Write-LogEntry "=========================================="
if ($DryRun) {
    Write-LogEntry "DRY RUN TOTAL: $GrandFound files would be deleted across all directories."
} else {
    Write-LogEntry "TOTAL: Removed $GrandRemoved files. Failed $GrandNotRemoved. (Found $GrandFound)"
}
Write-LogEntry "=========================================="
'@

# Build a PowerShell array literal from the directory list
$DirArrayLiteral = "@(" + (($LogDirectories | ForEach-Object { "'" + $_.TrimEnd('\') + "'" }) -join ", ") + ")"

# Inject configuration values into the script (replaces placeholder tokens)
$LogRemoverScript = $LogRemoverScript.Replace('__TARGET_LOG_DIRS__', $DirArrayLiteral)
$LogRemoverScript = $LogRemoverScript.Replace('__LOG_DIR__', $LogDir)
$LogRemoverScript = $LogRemoverScript.Replace('__DAYS_OLD__', $DaysOld)
$LogRemoverScript = $LogRemoverScript.Replace('__MAX_LOG_SIZE__', '50MB')
$LogRemoverScript = $LogRemoverScript.Replace('__MAX_LOG_FILES__', $MaxLogFiles)
$LogRemoverScript = $LogRemoverScript.Replace('__DRY_RUN__', "`$$DryRun")

# Write the script to file
try {
    Set-Content -Path $ScriptFile -Value $LogRemoverScript -Force
    Write-LogEntry "✓ Script created/updated: $ScriptFile"
    Write-LogEntry "  Config applied - DaysOld: $DaysOld, DryRun: $DryRun"
}
catch {
    Write-LogEntry "Failed to create script file: $_" "ERROR"
    Read-Host "Press Enter to exit"
    exit 1
}

# Create scheduled task
Write-LogEntry ""
Write-LogEntry "Creating scheduled task..."
Write-LogEntry ""

try {
    $Action = New-ScheduledTaskAction -Execute "powershell.exe" -Argument "-NoProfile -ExecutionPolicy Bypass -File `"$ScriptFile`""
    $Trigger = New-ScheduledTaskTrigger -Daily -At $ScheduleTime
    $Settings = New-ScheduledTaskSettingsSet -StartWhenAvailable -RunOnlyIfNetworkAvailable
    
    Register-ScheduledTask -TaskName $TaskName `
                          -Action $Action `
                          -Trigger $Trigger `
                          -Settings $Settings `
                          -Description "Safely removes log files older than $DaysOld days from several Folders see Script which is executed" `
                          -RunLevel Highest `
                          -Force | Out-Null
    
    Write-LogEntry "✓ Scheduled task created!"
    Write-LogEntry "  Task: $TaskName"
    Write-LogEntry "  Schedule: Daily at $ScheduleTime"
}
catch {
    Write-LogEntry "Failed to create scheduled task: $_" "ERROR"
    Read-Host "Press Enter to exit"
    exit 1
}



Write-LogEntry ""
Write-LogEntry "=========================================="
Write-LogEntry "  ✓ Installation Complete!"
Write-LogEntry "=========================================="
Write-LogEntry ""
Write-LogEntry "LogRemover is now installed and configured:"
Write-LogEntry "  • Script location: $ScriptFile"
Write-LogEntry "  • Scheduled task: $TaskName"
Write-LogEntry "  • Daily execution: $ScheduleTime"
Write-LogEntry "  • Removes files older than: $DaysOld days"
Write-LogEntry "  • Dry-run mode: $DryRun"
Write-LogEntry "  • Log location: $LogFile"
Write-LogEntry "  • Target directories:"
foreach ($d in $LogDirectories) { Write-LogEntry "      - $d" }
Write-LogEntry ""
Write-LogEntry "Safety features:"
Write-LogEntry "  ✓ Denylist of protected system paths"
Write-LogEntry "  ✓ Drive-root / shallow-path rejection"
Write-LogEntry "  ✓ Per-file directory verification (twice)"
Write-LogEntry "  ✓ Dry-run mode available"
Write-LogEntry "  ✓ Admin rights check"
Write-LogEntry ""
Write-LogEntry "You can close this window."
